# Generated by `node scripts/setup.mjs` — you normally don't write this by hand.
PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
DATABASE_URL=postgres://illam:change-me@db:5432/illam?sslmode=disable
AUTH_DATABASE_URL=postgres://illam:change-me@db:5432/illam?sslmode=disable&search_path=auth
POSTGRES_PASSWORD=change-me
JWT_SECRET=at-least-32-random-characters
ANON_KEY=jwt-signed-with-JWT_SECRET-role-anon
NEXT_PUBLIC_SUPABASE_ANON_KEY=same-as-ANON_KEY
SERVICE_ROLE_KEY=jwt-signed-with-JWT_SECRET-role-service_role
SUPABASE_SERVICE_ROLE_KEY=same-as-SERVICE_ROLE_KEY
ILLAM_HOUSEHOLD='{"members":[{"slug":"me","name":"Me"}]}'

# One per household member, for the Gmail Apps Script (scripts/gmail-apps-script/README.md).
INBOX_SECRET_ME=at-least-32-random-characters

# Optional. Statement PDF passwords per member, JSON keyed by source id (lib/inbox/sources.ts);
# "*" is tried for every source. Never stored in the database.
# STATEMENT_PASSWORDS_ME='{"cdsl_cas":["ABCDE1234F"],"*":["ABCDE1234F"]}'

# Optional. AI features; every one falls back to rules without it.
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic
# CDSL_PARSER=auto   # auto | claude | regex

# Optional. Save masked statement text to statement_samples so a new reader can be written.
# INBOX_CAPTURE_STATEMENT_TEXT=1
