{
  "name": "illam",
  "version": "0.1.0",
  "description": "Self-hostable household finance for Indian families: expenses, bank-mail inbox, statements and net worth.",
  "author": "Aatra (https://aatra.ai)",
  "homepage": "https://github.com/kriznaraj/illam#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kriznaraj/illam.git"
  },
  "bugs": {
    "url": "https://github.com/kriznaraj/illam/issues"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "vitest run && next build",
    "build:skip-tests": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "setup": "node scripts/setup.mjs",
    "user:create": "node scripts/create-user.mjs",
    "db:migrate": "docker compose run --rm migrate",
    "user:reset-password": "node scripts/reset-password.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@headlessui/react": "^2.2.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "date-fns": "^3.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "papaparse": "^5.7.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.12.0",
    "undici": "^8.12.4",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^20.14.6",
    "playwright": "1.65.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "license": "AGPL-3.0-only"
}
